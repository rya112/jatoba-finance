# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# ===== Obrigatório =====

# Usuário e senha para entrar na página.
# A senha precisa ter 14 caracteres ou mais e não pode ser esta do exemplo.
JATOBA_ADMIN_USER=admin
JATOBA_ADMIN_PASSWORD=troque-por-uma-frase-longa-e-unica

# Senha do banco de dados. Use só letras e números.
# Para gerar uma: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave PÚBLICA dos backups (começa com age1). Gere o par com:
#   docker compose run --rm --no-deps app jatoba keygen
# A chave PRIVADA que aparece junto NÃO entra aqui: guarde-a fora deste computador.
JATOBA_BACKUP_RECIPIENT=

# ===== Opcional =====

# Backup automático diário (precisa da chave pública acima). Liga sozinho; para desligar, false.
# Roda a partir da hora indicada (0 a 23, no fuso TZ) ou assim que o computador ligar depois dela,
# e guarda os N diários mais recentes. Manuais e os de antes de migrações nunca são apagados.
# JATOBA_BACKUP_DAILY=true
# JATOBA_BACKUP_HOUR=3
# JATOBA_BACKUP_KEEP=14

# Porta no seu computador (a página abre só em http://localhost:PORTA)
# JATOBA_PORT=8080

# Endereço pelo Tailscale, se você usar acesso remoto
# JATOBA_PUBLIC_URL=https://jatoba.sua-tailnet.ts.net

# Idioma, moeda e fuso
# JATOBA_LOCALE=pt-BR
# JATOBA_CURRENCY=BRL
# TZ=America/Sao_Paulo

# IA para sugerir categorias: none, anthropic ou ollama
# AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OLLAMA_URL=http://host.docker.internal:11434

# Bot do Telegram (opcional)
# TELEGRAM_BOT_TOKEN=
# Chat IDs que o bot aceita, separados por vírgula
# TELEGRAM_ALLOWED_CHAT_IDS=
# BOT_NAME=Jatobá

# Chave de autenticação do Tailscale (só com o perfil tailscale)
# TS_AUTHKEY=
